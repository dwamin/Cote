#include <iostream>
using namespace std;

int main()
{
    int T;
    cin >> T;
    int H, W, N;
    int i, j, k;

    for (i = 1; i <= T; i++)
    {
        int count = 0;
        bool found = false;
        cin >> H >> W >> N;
        for (j = 1; j <= W; j++)
        {
            for (k = 1; k <= H; k++)
            {
                count++;
                if (count == N)
                {
                    cout << k * 100 + j << '\n';
                    found = true;
                    break;
                }
            }
            if (found)
                break;
        }
    }
}