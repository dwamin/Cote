#include <iostream>
#include <ctime>
#include <iomanip>
using namespace std;

int main()
{
    time_t timer = time(NULL);
    struct tm *t = localtime(&timer);
    cout << t->tm_year + 1900 << "-";
    cout << setw(2) << setfill('0') << t->tm_mon + 1 << "-";
    cout << setw(2) << setfill('0') << t->tm_mday;
    return 0;
}