#include <iostream>
#include <string>
using namespace std;

int main()
{
    string S;
    cin >> S;
    char alpha = 'a';
    int result = -1;

    for (alpha = 'a'; alpha <= 'z'; alpha++)
    {
        for (int i = 0; i < S.length(); i++)
        {

            if (S[i] == alpha)
            {
                result = i;
                break;
            }
            else
                result = -1;
        }
        cout << result << " ";
    }
}