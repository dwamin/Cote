#include <iostream>
using namespace std;

int main()
{
    int A, B;
    do
    {
        cin >> A;
    } while (A < 1);
    do
    {
        cin >> B;
    } while (B <= 0 || B > 10000);
    cout << A + B << endl;
    cout << A - B << endl;
    cout << A * B << endl;
    cout << A / B << endl;
    cout << A % B << endl;
}