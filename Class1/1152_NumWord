#include <iostream>
#include <string>
using namespace std;

int main()
{
    string a;
    int num = 0;
    getline(cin, a);
    for (int i = 0; i < a.length(); i++)
    {
        if (a[i] == ' ')
            num++;
    }
    if (a.length() != 0) // if (!a.empty)
    {
        if (a[0] == ' ' && a[a.length() - 1] == ' ')
            cout << num - 1;
        else if (a[0] == ' ' || a[a.length() - 1] == ' ')
            cout << num;
        else
            cout << num + 1;
    }
    else
        cout << 0;
}