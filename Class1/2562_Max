#include <iostream>
using namespace std;

int main()
{
    int num;
    int index = 1;
    cin >> num;
    int best = num;
    for (int i = 2; i <= 9; i++)
    {
        cin >> num;
        if (num > best)
        {
            best = num;
            index = i;
        }
    }
    cout << best << endl;
    cout << index;
}