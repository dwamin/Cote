#include <iostream>
#include <string>
using namespace std;

int main()
{
    int A, B, C;
    cin >> A >> B >> C;
    int res = A * B * C;
    string result = to_string(res);
    int num[10] = {0};
    for (int i = 0; i < result.length(); i++)
    {
        for (int j = 0; j <= 9; j++)//j 반복문 안 쓰려면 num[result[i]-'0']++;
        {
            if (result[i] - '0' == j)
            {
                num[j] += 1;
            }
        }
    }
    for (int n = 0; n <= 9; n++)
    {
        cout << num[n] << '\n';
    }
}