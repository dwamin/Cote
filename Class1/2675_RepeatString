#include <iostream>
#include <string>
using namespace std;

int main()
{
    string S;
    int T, R;
    cin >> T;
    for (int t = 1; t <= T; t++)
    {
        cin >> R >> S;
        for (int i = 0; i < S.length(); i++)
        {
            for (int j = 1; j <= R; j++)
            {
                cout << S[i];
            }
        }
        cout << '\n';
    }
}