#include <iostream>
#include <string>
using namespace std;

int main()
{
    int n[8];
    bool asc = 1;
    bool desc = 1;
    for (int i = 0; i < 8; i++)
    {
        cin >> n[i];

        if (n[i] != i + 1)
        {
            asc = 0;
        }
        if (n[i] != 8 - i)
        {
            desc = 0;
        }
    }
    if (asc == 1)
        cout << "ascending";
    else if (desc == 1)
        cout << "descending";
    else
        cout << "mixed";
}