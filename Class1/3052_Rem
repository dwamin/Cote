#include <iostream>
using namespace std;

int main()
{
    int a[10];
    int num = 0;
    bool flag = 0;
    for (int i = 0; i < 10; i++)
    {
        cin >> a[i];
        a[i] = a[i] % 42;
        flag = 1;
        for (int j = 0; j <= i - 1; j++)
        {

            if (a[j] == a[i])
            {
                flag = 0;
                break;
            }
        }
        if (flag)
            num++;
    }

    cout << num;
}