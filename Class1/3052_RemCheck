#include <iostream>
using namespace std;

int main()
{
    int a[10];
    bool check[42] = {0};
    int num = 0;
    for (int i = 0; i < 10; i++)
    {
        cin >> a[i];
        a[i] = a[i] % 42;
        check[a[i]] = 1;
    }
    for (int j = 0; j < 42; j++)
    {
        if (check[j] == 1)
            num++;
    }
    cout << num;
}