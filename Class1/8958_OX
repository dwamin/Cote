#include <iostream>
#include <string>
using namespace std;

int main()
{
    int num;
    cin >> num;
    string result;
    int score;
    int streak = 0;

    for (int i = 0; i < num; i++)
    {
        score = 0;
        streak = 0;
        cin >> result;
        for (int j = 0; j < result.length(); j++)
        {
            if (result[j] == 'O')
            {
                streak += 1;
                score += streak;
            }
            else if (result[j] == 'X')
                streak = 0;
        }
        cout << score << '\n';
    }
}