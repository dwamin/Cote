#include <iostream>
#include <string>
using namespace std;

int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int num;
    cin >> num;

    while (num--)
    {
        string result;
        cin >> result;

        int score = 0;
        int streak = 0;

        for (char c : result)
        {
            if (c == 'O')
            {
                streak += 1;
                score += streak;
            }
            else
                streak = 0;
        }
        cout << score << '\n';
    }
    return 0;
}