#include <iostream>
using namespace std;

int N;
int i, temp;
bool flag;
int num[10000001] = {0};

void swap(int a, int b)
{
    temp = num[a];
    num[a] = num[b];
    num[b] = temp;
}

int main()
{
    for (i = 0; i < N; i++)
    {
        cin >> num[i];
    }
    i = 0;
    while (i < N - 1)
    {
        if (num[i] > num[i + 1])
        {
            swap(i, i + 1);
            i = 0;
        }
        else
            i++;
    }
    for (i = 0; i < N; i++)
    {
        cout << num[i] << '\n';
    }
    return 0;
}