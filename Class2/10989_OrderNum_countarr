#include <iostream>
using namespace std;

int count_arr[10001] = {
    0,
};
int main()
{
    int N;
    cin >> N;
    for (int i = 0; i < N; i++)
    {
        int temp;
        cin >> temp;
        count_arr[temp]++;
    }
    for (int i = 0; i <= 10000; i++)
    {
        for (int j = 0; j < count_arr[i]; j++)
        {
            cout << i << '\n';
        }
    }
    return 0;
}