#include <iostream>
using namespace std;

int main()
{
    int N, K;
    cin >> N >> K;

    // 규칙: nCk=(n-1)C(k-1)+(n-1)Ck
    long long C[11][11] = {0};
    for (int i = 0; i <= N; i++)
    {
        for (int j = 0; j <= i; j++)
        {
            //nC0, nCn은 항상 1
            if (i == 0 || j == 0)
                C[i][j] = 1;
            else
                C[i][j] = C[i - 1][j - 1] + C[i - 1][j];
        }
    }
    cout << C[N][K];
    return 0;
}