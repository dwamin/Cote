#include <iostream>
using namespace std;

int main()
{
    int N, K;
    cin >> N >> K;
    long long numer = 1;
    long long denom = 1;
    for (int i = 1; i <= N; i++)
    {
        numer *= i;
    }
    for (int j = 1; j <= K; j++)
    {
        denom *= j;
    }
    for (int k = 1; k <= N - K; k++)
    {
        denom *= k;
    }
    cout << numer / denom;
    return 0;
}