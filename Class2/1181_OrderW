#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
using namespace std;

bool compare(string a, string b)
{
    if (a.length() != b.length()) // 두 단어의 길이가 다른지 확인
    {
        return a.length() < b.length(); // 짧은 단어가 앞에 있으면 true->정렬 안 함, false면 swap함
    }
    return a < b; // 두 단어의 길이가 같으면 사전 순으로 앞에 오는 게 true
}
int main()
{
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int N;
    cin >> N;
    vector<string> v(N);

    for (int i = 0; i < N; i++)
    {
        cin >> v[i];
    }
    sort(v.begin(), v.end(), compare); // 무조건 true가 나오도록 계속 자리를 바꾸는 sort. 여기서 compare는 가이드라인

    for (int i = 0; i < N; i++)
    {
        if (i == 0 || v[i] != v[i - 1])
        {
            cout << v[i] << '\n';
        }
    }
    return 0;
}