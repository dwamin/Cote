#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    char ISBN[13];
    int sum = 0;
    int num;
    for (int i = 0; i < 13; i++)
    {
        cin >> ISBN[i];

        if (ISBN[i] == '*')
        {
            num = i;
        }
        else
        {
            int val = ISBN[i] - '0';
            if ((i + 1) % 2 == 1)
                sum += val;
            else
                sum += 3 * val;
        }
        for (int n = 0; n <= 9; n++)
        {
            int total = sum;
            if ((num + 1) % 2 == 1)
                total += n;
            else
                total += 3 * n;
            if (total % 10 == 0)
            {
                cout << n << '\n';
                break;
            }
        }
        return 0;
    }