#include <iostream>
using namespace std;

int main()
{
    double N;
    cin >> N;
    double score[1001];
    double max = 0;
    double sum = 0;
    for (int i = 0; i < N; i++)
    {
        cin >> score[i];
        if (max < score[i])
            max = score[i];
    }
    for (int j = 0; j < N; j++)
    {
        score[j] = score[j] / max * 100;
        sum += score[j];
    }
    cout << sum / N;
}