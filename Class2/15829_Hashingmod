#include <iostream>
#include <string>
using namespace std;

int main()
{
    int L;
    cin >> L;
    string s;
    cin >> s;
    long long sum = 0;
    long long r = 1;
    long long M = 1234567891;
    for (int i = 0; i < L; i++)
    {
        sum = (sum + (s[i] - 'a' + 1) * r) % M;
        r = (r * 31) % M;
    }
    cout << sum;
}