#include <iostream>
using namespace std;

int main()
{
    int N;
    cin >> N;
    int n[101];
    bool flag = 1;
    int num = 0;
    for (int i = 0; i < N; i++)
    {
        cin >> n[i];
        flag = 1;
        if (n[i] == 0 || n[i] == 1)
            flag = 0;

        for (int j = 2; j < n[i]; j++)
        {
            if (n[i] % j == 0)
            {
                flag = 0;
                break;
            }
        }
        if (flag == 1)
            num += 1;
    }
    cout << num;
}