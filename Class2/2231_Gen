#include <iostream>
using namespace std;

int main()
{
    int N;
    cin >> N;
    int num;

    for (int M = 1; M < N; M++)
    {
        int temp = 0;
        num = M;
        while (num > 0)
        {
            temp += num % 10;
            num = num / 10;
        }

        if (N == M + temp)
        {
            cout << M;
            return 0;
        }
    }
    cout << "0";
}