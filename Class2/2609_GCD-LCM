#include <iostream>
using namespace std;

int main()
{
    int A, B;
    cin >> A >> B;
    int GCD = 1;
    int small = (A < B) ? A : B;
    for (int i = 2; i < small; i++)
    {
        if (A % i == 0 && B % i == 0 && i > GCD)
            GCD = i;
    }
    cout << GCD << '\n';
    int LCM = (A * B) / GCD;
    cout << LCM;
}