#include <iostream>
using namespace std;

int main()
{
    int apart[15][15] = {};
    int T;
    cin >> T;
    while (T--)
    {
        int k, n;
        cin >> k;
        cin >> n;
        for (int i = 1; i <= n; i++)
        {
            apart[0][i] = i;
        }
        for (int i = 1; i <= k; i++) // 층
        {
            for (int j = 1; j <= n; j++) // 호
            {
                int sum = 0;
                for (int l = 1; l <= j; l++)
                {
                    sum += apart[i - 1][l];
                }
                apart[i][j] = sum;
            }
        }

        cout << apart[k][n] << '\n';
    }
    return 0;
}