#include <iostream>
using namespace std;

int main()
{
    int apart[15][15] = {
        0,
    };
    for (int i = 1; i <= 14; i++) // 0층 채우기
    {
        apart[0][i] = i;
    }
    for (int i = 1; i <= 14; i++)
    {
        for (int j = 1; j <= 14; j++)
        {
            if (j == 1)
                apart[i][j] = 1;
            else
                apart[i][j] = apart[i][j - 1] + apart[i - 1][j];
        }
    }
    int T;
    cin >> T;
    int k, n;
    for (int i = 0; i < T; i++)
    {
        cin >> k;
        cin >> n;
        cout << apart[k][n] << '\n';
    }
    return 0;
}