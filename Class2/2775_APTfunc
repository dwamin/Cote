#include <iostream>
using namespace std;

int get_people(int k, int n)
{
    if (k == 0)
        return n;
    if (n == 1)
        return 1;

    int total = 0;
    for (int i = 1; i <= n; i++)
    {
        total += get_people(k - 1, i);
    }
    return total;
}
int main()
{
    int T;
    cin >> T;
    while (T--)
    {
        int k, n;
        cin >> k;
        cin >> n;
        cout << get_people(k, n) << '\n';
    }
    return 0;
}