#include <iostream>
using namespace std;

int main()
{
    int N;
    int M;
    cin >> N >> M;
    int card[101];
    for (int c = 0; c < N; c++)
    {
        cin >> card[c];
    }
    int sum;
    int max = 0;
    for (int i = 0; i <= N - 2; i++)
    {
        for (int j = i + 1; j < N - 1; j++)
        {
            for (int k = j + 1; k < N; k++)
            {
                sum = card[i] + card[j] + card[k];
                if (sum <= M && sum > max)
                {
                    max = sum;
                }
            }
        }
    }
    cout << max;
}