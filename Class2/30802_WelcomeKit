#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    long long N;
    cin >> N;
    long long t = 0;
    long long size[6];
    for (int i = 0; i < 6; i++)
    {
        cin >> size[i];
    }
    long long T, P;
    cin >> T >> P;
    for (int j = 0; j < 6; j++)
    {
        t += (size[j] / T);
        if (size[j] % T != 0)
            t += 1;
    }
    cout << t << '\n';
    cout << N / P << " " << N % P;
}