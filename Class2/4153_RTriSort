#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
    int sides[3];
    while (true)
    {
        for (int i = 0; i < 3; i++)
            cin >> sides[i];
        if (sides[0] == 0 && sides[1] == 0 && sides[2] == 0)
            break;

        sort(sides, sides + 3);

        if (sides[2] * sides[2] == sides[0] * sides[0] + sides[1] * sides[1])
            cout << "right" << '\n';
        else
            cout << "wrong" << '\n';
    }
}