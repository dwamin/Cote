#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void solve(int caseNum)
{
    int N, K;
    cin >> N >> K;

    vector<int> price(N);
    for (int i = 0; i < N; i++)
    {
        cin >> price[i];
    }
    vector<int> dp(N, 1);
    int totalMax = 0;

    for (int i = 0; i < N; i++)
    {
        for (int j = 0; j < i; j++)
        {
            if (price[j] < price[i])
            {
                dp[i] = max(dp[i], dp[j] + 1);
            }
        }
        totalMax=max(totalMax, dp[i]);
    }
}
int main()
{
    cout<<totalMax;
}